// claim-guard is a quality gate: it finds every promise a code change makes, then sends a panel of skeptical reviewers to try to prove each promise false before the change is allowed to ship.

digraph claim_guard {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="Claim Guard v0.1.0 — The \"Prove It\" Gate for Code Changes\nFinds the promises a change makes, then tries hard to disprove them"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="2444b27b87f05180de43830f4b2d5195840d882ce52860074f8ec3bda04ce8af"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    root_claim_guard [label="Claim Guard (main package) v0.1.0\n0 tools · 0 agents\n~1231 tok aggregate", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", penwidth=2]

    subgraph cluster_behaviors {
        label="Ways of Working (skill sets this package can switch on)"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        beh_claim_guard_probing [label="Hands-On Testing Mode\nActually runs experiments to break promises\n1 tools\n~1825 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
        beh_claim_guard_behavior [label="Core Review Mode\nReads the code and challenges every promise\n3 tools · 1 ctx\n~4166 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
    }

    subgraph cluster_standalones {
        label="Ready-Made Packages You Can Install"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        sta_claim_guard_with_probing [label="Claim Guard + Hands-On Testing\nThe full version, review plus live experiments", shape=box, fillcolor="#80cbc4", style="filled,rounded"]
    }

    subgraph cluster_agents {
        label="The Review Panel (each specialist checks one thing)"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        agt_boundary_adversary [label="Extreme-Value Tester\nFeeds in the odd number that breaks the rule\n~278 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_chokepoint_mapper [label="Coverage Mapper\nChecks the safeguard covers every route in\n~289 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_claim_harvester [label="Promise Collector\nLists every promise the change states out loud\n~267 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_correspondence_auditor [label="Code Fact-Checker\nTries to prove each promise false in the real code\n~272 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_empirical_verifier [label="Run-It-And-See Checker\nRuns the code instead of just reading it\n~480 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_pen_tester [label="Break-It Tester\nRecreates bad conditions and tries to cause harm\n~362 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_probe_designer [label="Experiment Designer\nDesigns the test that would expose a false promise\n~380 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_purpose_inquisitor [label="Unspoken-Promise Finder\nNames what the change quietly promises but never says\n~279 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_regression_graduator [label="Keeper of Lasting Tests\nDecides which experiments become permanent safety nets\n~327 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_test_correspondence_auditor [label="Test Honesty Auditor\nChecks the tests actually catch the failure claimed\n~289 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
    }

    subgraph cluster_modules {
        label="Built-In Tools"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        mod_tool_claim_ledger [label="Promise Ledger\nThe shared record of every promise and its verdict", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
    }

    subgraph cluster_context {
        label="Background Reading (loaded into the reviewers)"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        ctx_claim_guard_awareness_md [label="How To Use This Gate\nclaim-guard-awareness.md\n~447 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Legend — What Each Colour Means"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="main package", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="way of working", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
