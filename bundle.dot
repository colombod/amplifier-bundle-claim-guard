        leg_context [label="background reading", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="ready-made package", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="experiment", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="borrowed, adds cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="borrowed, free", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="\"tok\" = a rough measure of how much reading the AI must do (~4 characters per token)\nSolid border = lives in this repository (counted here)\nDashed + red = borrowed from elsewhere, still adds reading cost (not counted here)\nDashed + grey = borrowed from elsewhere, no reading cost\nNot included: work done by helper sessions, or anything decided while running", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]

    ext_githttps___github_com_microsoft_amplifier_foundation_main [label="Amplifier Foundation\nShared building blocks borrowed from another project\n(external, adds cost)", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2]

    root_claim_guard -> ext_githttps___github_com_microsoft_amplifier_foundation_main [style=dashed]
